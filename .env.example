# App
APP_NAME=AI-WAF
ENV=production
DEBUG=false

# Auth — change ALL of these before deploying
SECRET_KEY=replace-with-a-very-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Database
# Local SQLite (default — no setup needed):
DATABASE_URL=sqlite:///./ai_waf.db
# PostgreSQL (Docker / Render / production):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# Render auto-provides this via the 'fromDatabase' binding in render.yaml

# ML model — optional
# Leave default for keyword-only mode (Render free tier)
MODEL_DIR=./model/final
ATTACK_CONFIDENCE_THRESHOLD=0.75

# CORS — comma-separated list of allowed frontend origins
# Add your Vercel URL here once deployed:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Example for production:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
